// SmartRentBoss data model.
// Landlords, properties, units, tenants, the rent ledger, and Ontario
// rent-increase drafts are in use.
// Expenses and a full N4 workflow are reserved for later modules.
// Documents are stored for the signed-in landlord.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties           Property[]
  tenants              Tenant[]
  expenses             Expense[]
  documents            Document[]
  notices              Notice[]
  payments             RentPayment[]
  reminderRules        ReminderRule[]
  remindersConfigured  Boolean              @default(false)
  agentTokens          AgentAccessToken[]
  agentConfirmations   AgentConfirmation[]
  agentAuditLogs       AgentAuditLog[]
  documentAudits       DocumentAuditLog[]
}

model Property {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String?
  streetAddress String
  city          String
  province      String   @default("ON")
  postalCode    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units     Unit[]
  expenses  Expense[]
  documents Document[]

  @@index([ownerId])
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  bedrooms   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenancies Tenancy[]
  expenses  Expense[]
  documents Document[]

  // True when the unit was first occupied for residential use after
  // November 15, 2018. Those units are exempt from the guideline.
  guidelineExempt   Boolean @default(false)
  exemptionEvidence String?

  @@index([propertyId])
}

model Tenant {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenancies Tenancy[]
  documents Document[]

  @@index([ownerId])
}

model Tenancy {
  id               String         @id @default(cuid())
  unitId           String
  unit             Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaseStart       DateTime       @db.Date
  leaseEnd         DateTime?      @db.Date
  monthlyRentCents  Int
  rentDueDay        Int
  moveInOn          DateTime       @db.Date
  lastIncreaseOn    DateTime?      @db.Date
  lastIncreaseCents Int?
  status            TenancyStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  charges   RentCharge[]
  payments  RentPayment[]
  notices   Notice[]
  documents Document[]

  @@index([unitId])
  @@index([tenantId])
}

enum TenancyStatus {
  ACTIVE
  ENDED
}

// One expected rent charge for a lease month. The amount and due date are
// copied from the lease when the month is opened, so a later rent change
// does not rewrite months that are already on the ledger.
model RentCharge {
  id          String   @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  dueOn       DateTime @db.Date
  amountCents Int
  createdAt   DateTime @default(now())

  allocations PaymentAllocation[]

  @@unique([tenancyId, periodStart])
  @@index([tenancyId])
}

// Money the landlord recorded against a lease. A payment can cover more
// than one month; PaymentAllocation is how it is split.
model RentPayment {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId       String
  tenancy         Tenancy       @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  amountCents     Int
  paidOn          DateTime      @db.Date
  method          PaymentMethod
  referenceNumber String?
  // Set only for an e-Transfer that has a reference. The unique key
  // stops the same transfer from being posted twice. Other methods
  // leave this empty, and Postgres allows more than one empty value.
  referenceKey    String?
  note            String?
  createdAt       DateTime      @default(now())

  allocations PaymentAllocation[]

  @@unique([ownerId, referenceKey])
  @@index([ownerId])
  @@index([tenancyId])
}

model PaymentAllocation {
  id          String      @id @default(cuid())
  paymentId   String
  payment     RentPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId    String
  charge      RentCharge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountCents Int

  @@index([paymentId])
  @@index([chargeId])
}

// offsetDays is relative to the due date: -3 is three days before,
// 0 is the due date, and 3 is three days late.
model ReminderRule {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  offsetDays Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([ownerId, offsetDays])
  @@index([ownerId])
}

enum PaymentMethod {
  E_TRANSFER
  CHEQUE
  CASH
  PRE_AUTHORIZED
  OTHER
}

enum AgentTokenScope {
  READ
  WRITE
}

// A personal access token for an assistant. Only the hash is stored.
// The landlord sees the secret once, on the Agent access page.
model AgentAccessToken {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String            @unique
  tokenPrefix String
  scopes      AgentTokenScope[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())

  auditLogs AgentAuditLog[]

  @@index([ownerId])
}

// One-time proof that the landlord's agent previewed a money or
// notice change and is allowed to commit that exact change.
model AgentConfirmation {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  tool      String
  payload   Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
}

// Every tool call made with an agent token. viaAgent is always true
// so the activity page can show the "via agent" tag.
model AgentAuditLog {
  id        String            @id @default(cuid())
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenId   String?
  token     AgentAccessToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  tool      String
  status    String
  summary   String
  viaAgent  Boolean           @default(true)
  createdAt DateTime          @default(now())

  @@index([ownerId, createdAt])
}

// Operating expenses, grouped the way CRA form T776 lists them.
// Not shown in the app yet.
model Expense {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  incurredOn  DateTime     @db.Date
  amountCents Int
  category    T776Category
  vendor      String?
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  documents Document[]

  @@index([ownerId])
  @@index([propertyId])
}

// Line numbers match the expense section of CRA form T776.
enum T776Category {
  ADVERTISING
  INSURANCE
  INTEREST_BANK_CHARGES
  OFFICE
  PROFESSIONAL_FEES
  MANAGEMENT_FEES
  REPAIRS_MAINTENANCE
  SALARIES_WAGES
  PROPERTY_TAXES
  TRAVEL
  UTILITIES
  MOTOR_VEHICLE
  OTHER
}

// A file the landlord uploaded, or a generated notice PDF they chose to keep.
// storageKey is the private object name. It is never a public URL.
model Document {
  id         String          @id @default(cuid())
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subject    DocumentSubject @default(PROPERTY)
  propertyId String?
  property   Property?       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId   String?
  tenant     Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenancyId  String?
  tenancy    Tenancy?        @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  expenseId  String?
  expense    Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  noticeId   String?
  notice     Notice?         @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  kind       DocumentKind
  fileName   String
  storageKey String
  mimeType   String?
  byteSize   Int?
  expiresOn  DateTime?       @db.Date
  createdAt  DateTime        @default(now())

  @@index([ownerId])
  @@index([ownerId, expiresOn])
  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([tenancyId])
  @@index([noticeId])
}

enum DocumentSubject {
  PROPERTY
  UNIT
  TENANT
  LEASE
}

enum DocumentKind {
  LEASE
  NOTICE
  RECEIPT
  INVOICE
  OTHER
  ID
  INSURANCE
  INSPECTION
}

enum DocumentAuditAction {
  UPLOAD
  DELETE
}

// Written when a file is uploaded or deleted. The row stays after the
// file is gone, so documentId is not a foreign key.
model DocumentAuditLog {
  id         String              @id @default(cuid())
  ownerId    String
  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documentId String?
  action     DocumentAuditAction
  fileName   String
  summary    String
  createdAt  DateTime            @default(now())

  @@index([ownerId, createdAt])
}

// Yearly rent increase guideline for a province. Ontario rows are
// maintained in Settings. An N1 draft is blocked while the increase
// year's row is missing or not verified.
model RentGuideline {
  id          String   @id @default(cuid())
  province    String
  year        Int
  basisPoints Int
  sourceUrl   String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([province, year])
}

// Landlord and Tenant Board notices. N4 is the non-payment notice.
// N1 and N2 are rent increase drafts. Nothing here is served.
model Notice {
  id               String       @id @default(cuid())
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId        String
  tenancy          Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  type             NoticeType
  status           NoticeStatus @default(DRAFT)
  totalOwingCents  Int?
  terminationDate  DateTime?    @db.Date
  servedOn         DateTime?    @db.Date
  serviceMethod    String?
  notes            String?
  effectiveOn          DateTime? @db.Date
  currentRentCents     Int?
  newRentCents         Int?
  guidelineYear        Int?
  guidelineBasisPoints Int?
  guidelineSourceUrl   String?
  warningCodes         String[]  @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  documents Document[]

  @@index([ownerId])
  @@index([tenancyId])
}

enum NoticeType {
  N4
  N1
  N2
}

enum NoticeStatus {
  DRAFT
  SERVED
  VOID
}
