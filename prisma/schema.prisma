// SmartRentBoss data model.
// Landlords, properties, units, tenants, the rent ledger, and Ontario
// notices are in use. Money is integer cents. A rent period is an
// explicit YYYY-MM value, never a phrase parsed at read time.
// Document file storage is reserved for a later module.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties           Property[]
  tenants              Tenant[]
  expenses             Expense[]
  documents            Document[]
  notices              Notice[]
  payments             RentPayment[]
  reminderRules        ReminderRule[]
  remindersConfigured  Boolean              @default(false)
  agentTokens          AgentAccessToken[]
  agentConfirmations   AgentConfirmation[]
  agentAuditLogs       AgentAuditLog[]
  ledgerCharges        LedgerCharge[]
  rentCredits          RentCredit[]
  legalCases           LegalCase[]
  propertyOwners       PropertyOwner[]
  importBatches        ImportBatch[]
  ledgerOverrides      LedgerOverride[]
  rentChanges          RentChange[]
}

model Property {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String?
  streetAddress String
  city          String
  province      String   @default("ON")
  // ON uses Ontario notices. QC is a record-only ledger.
  jurisdiction  Jurisdiction @default(ON)
  postalCode    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units         Unit[]
  expenses      Expense[]
  documents     Document[]
  owners        PropertyOwner[]
  importBatches ImportBatch[]

  @@index([ownerId])
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label      String
  bedrooms   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenancies Tenancy[]
  expenses  Expense[]
  documents Document[]

  // True when the unit was first occupied for residential use after
  // November 15, 2018. Those units are exempt from the guideline.
  guidelineExempt   Boolean @default(false)
  exemptionEvidence String?

  @@index([propertyId])
}

model Tenant {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenancies  Tenancy[]
  legalCases LegalCase[]

  @@index([ownerId])
}

model Tenancy {
  id               String         @id @default(cuid())
  unitId           String
  unit             Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaseStart       DateTime       @db.Date
  leaseEnd         DateTime?      @db.Date
  monthlyRentCents  Int
  rentDueDay        Int
  moveInOn          DateTime       @db.Date
  lastIncreaseOn    DateTime?      @db.Date
  lastIncreaseCents Int?
  // Last month's rent held for this lease, in cents. Applied deposit
  // is counted against depositAppliedPeriod and is not inferred.
  depositHeldCents     Int            @default(0)
  depositAppliedOn     DateTime?      @db.Date
  depositAppliedPeriod String?
  status            TenancyStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  charges       RentCharge[]
  payments      RentPayment[]
  notices       Notice[]
  documents     Document[]
  ledgerCharges LedgerCharge[]
  rentCredits   RentCredit[]
  legalCases    LegalCase[]
  rentChanges   RentChange[]

  @@index([unitId])
  @@index([tenantId])
}

enum TenancyStatus {
  ACTIVE
  ENDED
}

// One expected rent charge for a lease month. The amount and due date are
// copied from the lease when the month is opened, so a later rent change
// does not rewrite months that are already on the ledger.
model RentCharge {
  id          String   @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  // Explicit rental period, YYYY-MM. portion is empty for a full month
  // and "1", "2", ... for a partial period such as "January 2026 (Part 1)".
  period      String
  portion     String   @default("")
  dueOn       DateTime @db.Date
  amountCents Int
  createdAt   DateTime @default(now())

  allocations PaymentAllocation[]

  @@unique([tenancyId, period, portion])
  @@index([tenancyId])
}

// Money the landlord recorded against a lease. A payment can cover more
// than one month; PaymentAllocation is how it is split.
model RentPayment {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId       String
  tenancy         Tenancy       @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  amountCents     Int
  paidOn          DateTime      @db.Date
  method          PaymentMethod
  referenceNumber String?
  referenceType   PaymentReferenceType @default(NONE)
  // Set only for an e-Transfer that has a reference. The unique key
  // stops the same transfer from being posted twice. Other methods
  // leave this empty, and Postgres allows more than one empty value.
  referenceKey    String?
  // Always set. Interac and cheque numbers are unique per landlord.
  // With no reference, the key is the payer, date, and amount.
  dedupeKey       String
  allocationMode  AllocationMode       @default(AUTO)
  importKey       String?
  note            String?
  createdAt       DateTime      @default(now())

  allocations PaymentAllocation[]

  @@unique([ownerId, referenceKey])
  @@unique([ownerId, dedupeKey])
  @@unique([ownerId, importKey])
  @@index([ownerId])
  @@index([tenancyId])
}

model PaymentAllocation {
  id             String        @id @default(cuid())
  paymentId      String
  payment        RentPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId       String?
  charge         RentCharge?   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  ledgerChargeId String?
  ledgerCharge   LedgerCharge? @relation(fields: [ledgerChargeId], references: [id], onDelete: Cascade)
  amountCents    Int

  @@index([paymentId])
  @@index([chargeId])
  @@index([ledgerChargeId])
}

// offsetDays is relative to the due date: -3 is three days before,
// 0 is the due date, and 3 is three days late.
model ReminderRule {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  offsetDays Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([ownerId, offsetDays])
  @@index([ownerId])
}

enum PaymentMethod {
  E_TRANSFER
  CHEQUE
  CASH
  PRE_AUTHORIZED
  OTHER
}

enum AgentTokenScope {
  READ
  WRITE
}

// A personal access token for an assistant. Only the hash is stored.
// The landlord sees the secret once, on the Agent access page.
model AgentAccessToken {
  id          String            @id @default(cuid())
  ownerId     String
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String            @unique
  tokenPrefix String
  scopes      AgentTokenScope[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime          @default(now())

  auditLogs AgentAuditLog[]

  @@index([ownerId])
}

// One-time proof that the landlord's agent previewed a money or
// notice change and is allowed to commit that exact change.
model AgentConfirmation {
  id        String    @id @default(cuid())
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  tool      String
  payload   Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
}

// Every tool call made with an agent token. viaAgent is always true
// so the activity page can show the "via agent" tag.
model AgentAuditLog {
  id        String            @id @default(cuid())
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenId   String?
  token     AgentAccessToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  tool      String
  status    String
  summary   String
  viaAgent  Boolean           @default(true)
  createdAt DateTime          @default(now())

  @@index([ownerId, createdAt])
}

// Operating expenses, grouped the way CRA form T776 lists them.
// amountCents is the total. subtotalCents plus hstCents equals that total.
model Expense {
  id          String       @id @default(cuid())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  incurredOn  DateTime     @db.Date
  amountCents       Int
  subtotalCents     Int          @default(0)
  hstCents          Int          @default(0)
  category          T776Category
  vendor            String?
  invoiceNumber     String?
  description       String
  receiptDocumentId String?
  importKey         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  documents Document[]

  @@unique([ownerId, importKey])
  @@index([ownerId])
  @@index([propertyId])
}

// Line numbers match the expense section of CRA form T776.
enum T776Category {
  ADVERTISING
  INSURANCE
  INTEREST_BANK_CHARGES
  OFFICE
  PROFESSIONAL_FEES
  MANAGEMENT_FEES
  REPAIRS_MAINTENANCE
  SALARIES_WAGES
  PROPERTY_TAXES
  TRAVEL
  UTILITIES
  MOTOR_VEHICLE
  OTHER
}

// Files such as leases, notices, and receipts. Storage itself is not
// built yet; storageKey is the future location of the file.
model Document {
  id         String       @id @default(cuid())
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenancyId  String?
  tenancy    Tenancy?     @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  expenseId  String?
  expense    Expense?     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  noticeId   String?
  notice     Notice?      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  kind       DocumentKind
  fileName   String
  storageKey String
  mimeType   String?
  byteSize   Int?
  createdAt  DateTime     @default(now())

  @@index([ownerId])
}

enum DocumentKind {
  LEASE
  NOTICE
  RECEIPT
  INVOICE
  OTHER
}

// Yearly rent increase guideline for a province. Ontario rows are
// maintained in Settings. An N1 draft is blocked while the increase
// year's row is missing or not verified.
model RentGuideline {
  id          String   @id @default(cuid())
  province    String
  year        Int
  basisPoints Int
  sourceUrl   String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([province, year])
}

// Landlord and Tenant Board notices. N4 is the non-payment notice.
// N1 and N2 are rent increase drafts. An N4 stays a draft until the
// landlord confirms it, and becomes served only after service is recorded.
model Notice {
  id               String       @id @default(cuid())
  ownerId          String
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId        String
  tenancy          Tenancy      @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  type             NoticeType
  status           NoticeStatus @default(DRAFT)
  totalOwingCents  Int?
  terminationDate  DateTime?    @db.Date
  servedOn         DateTime?    @db.Date
  serviceMethod    String?
  notes            String?
  effectiveOn          DateTime? @db.Date
  currentRentCents     Int?
  newRentCents         Int?
  guidelineYear        Int?
  guidelineBasisPoints Int?
  guidelineSourceUrl   String?
  warningCodes         String[]  @default([])
  // Day the landlord plans to give the N4, before service is recorded.
  givenOn          DateTime?        @db.Date
  confirmedAt      DateTime?
  rentFrequency    RentFrequency?
  // Method used to calculate the termination date.
  n4ServiceMethod  N4ServiceMethod?
  landlordName     String?
  landlordContact  String?
  tenantNames      String?
  unitAddress      String?
  // Snapshot of the N4 rent-owing rows. Later payments do not rewrite it.
  arrearsRows      Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  documents  Document[]
  rentChange RentChange?

  @@index([ownerId])
  @@index([tenancyId])
}

enum RentFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum N4ServiceMethod {
  IN_PERSON
  MAILBOX
  UNDER_DOOR
  FAX
  COURIER
  MAIL
  XPRESSPOST
}

enum NoticeType {
  N4
  N1
  N2
}

enum NoticeStatus {
  DRAFT
  SERVED
  VOID
}

enum Jurisdiction {
  ON
  QC
}

enum PaymentReferenceType {
  INTERAC
  CHEQUE
  OTHER
  NONE
}

enum AllocationMode {
  AUTO
  EXPLICIT
}

enum LedgerChargeKind {
  WATER
  UTILITIES
  FEE
  LTB_FILING
  OTHER
}

enum CreditKind {
  IN_KIND
  OFFSET
}

enum LegalCaseType {
  N4
  L1
  L2
  N12
  OTHER
}

enum LegalCaseStatus {
  OPEN
  SERVED
  FILED
  HEARING_SET
  DECIDED
  WITHDRAWN
  CLOSED
}

enum ImportBatchStatus {
  STAGED
  COMMITTED
}

enum ImportRowStatus {
  PENDING
  APPROVED
  REJECTED
  COMMITTED
}

enum ImportRowKind {
  HEADER
  TENANCY
  LEDGER
  EXPENSE
}

// A non-rent charge with its own balance. Rent stays on RentCharge.
model LedgerCharge {
  id           String           @id @default(cuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId    String
  tenancy      Tenancy          @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  kind         LedgerChargeKind
  period       String?
  description  String
  amountCents  Int
  dueOn        DateTime         @db.Date
  importKey    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  allocations PaymentAllocation[]

  @@unique([ownerId, importKey])
  @@index([ownerId])
  @@index([tenancyId])
}

// In-kind rent or an offset, such as a tenant-bought appliance or a repair credit.
model RentCredit {
  id           String     @id @default(cuid())
  ownerId      String
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId    String
  tenancy      Tenancy    @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  amountCents  Int
  kind         CreditKind
  reason       String
  documentId   String?
  period       String?
  effectiveOn  DateTime   @db.Date
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ownerId])
  @@index([tenancyId])
}

// One rent amount and the date it took effect, optionally tied to an N1 or N2 draft.
model RentChange {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenancyId      String
  tenancy        Tenancy  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  effectiveOn    DateTime @db.Date
  previousCents  Int
  amountCents    Int
  noticeId       String?  @unique
  notice         Notice?  @relation(fields: [noticeId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime @default(now())

  @@index([ownerId])
  @@index([tenancyId])
}

model LegalCase {
  id              String          @id @default(cuid())
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenancyId       String
  tenancy         Tenancy         @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  type            LegalCaseType
  typeDetail      String?
  servedOn        DateTime?       @db.Date
  filedOn         DateTime?       @db.Date
  ltbFileNumber   String?
  filingFeeCents  Int?
  hearingOn       DateTime?       @db.Date
  status          LegalCaseStatus @default(OPEN)
  outcome         String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([ownerId, ltbFileNumber])
  @@index([ownerId])
  @@index([tenancyId])
  @@index([tenantId])
  @@index([hearingOn])
}

// Co-owners. shareBps is basis points: 5000 is 50%.
model PropertyOwner {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  shareBps   Int
  createdAt  DateTime @default(now())

  @@index([ownerId])
  @@index([propertyId])
}

model ImportBatch {
  id             String            @id @default(cuid())
  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceName     String
  sourceHash     String
  status         ImportBatchStatus @default(STAGED)
  reconciliation Json
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  rows ImportRow[]

  @@unique([ownerId, sourceHash])
  @@index([ownerId])
  @@index([propertyId])
}

model ImportRow {
  id              String          @id @default(cuid())
  ownerId         String
  batchId         String
  batch           ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowIndex        Int
  kind            ImportRowKind
  rawText         String
  parsed          Json
  confidence      Int
  flags           String[]        @default([])
  needsReview     Boolean         @default(false)
  status          ImportRowStatus @default(PENDING)
  idempotencyKey  String
  periodOverride  String?
  committedId     String?
  createdAt       DateTime        @default(now())

  @@unique([batchId, idempotencyKey])
  @@index([ownerId])
  @@index([batchId])
}

// A landlord correction. The stored record is this version.
// Later agent or import runs do not overwrite the listed fields.
model LedgerOverride {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  fields     String[]
  reason     String
  before     Json
  after      Json
  createdAt  DateTime @default(now())

  @@index([ownerId, entityType, entityId])
}
