# Copy this file to .env before you start the app.
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env

# Postgres connection. These values match docker-compose.yml.
DATABASE_URL="postgresql://smartrent:smartrent@localhost:5432/smartrentboss?schema=public"

# Signs the login cookie. This value is fine while you try the app on
# your own computer. Change it before anyone else can reach the app.
# New value: openssl rand -base64 32
AUTH_SECRET="dev-only-smartrentboss-secret-change-me"

# The address you open in the browser.
AUTH_URL="http://localhost:3000"

# Optional. Each agent token can make this many calls per minute.
# AGENT_RATE_LIMIT_PER_MINUTE=60

# Document storage. Both values are required in production. They stay on the
# server. Do not prefix them with NEXT_PUBLIC_.
# When either value is missing, the Documents page says storage is not configured.
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional override. The setup SQL creates a private bucket with this name.
# SUPABASE_DOCUMENT_BUCKET="landlord-documents"

# Optional local files, for trying uploads without Supabase.
# Writes under .data/documents on this computer. Ignored when the Supabase
# variables above are both set.
# DOCUMENT_STORAGE="local"
